<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:background="@color/pink" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginLeft="4dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" android:src="@android:drawable/ic_menu_revert" />
        <TextView android:id="@+id/tv_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:ellipsize="end" android:maxLines="1"
            android:text="@string/tab_dynamic" android:textColor="@color/white" android:textSize="16sp" />
        <TextView android:id="@+id/btn_switch_mode" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:paddingLeft="12dp" android:paddingRight="12dp"
            android:text="我的关注" android:textColor="@color/white" android:textSize="14sp" />
        <EditText android:id="@+id/et_mid" android:layout_width="90dp" android:layout_height="36dp"
            android:hint="输入UID" android:inputType="number" android:textColorHint="#80FFFFFF"
            android:textColor="@color/white" android:textSize="13sp" android:visibility="gone" android:background="#33FFFFFF" />
        <TextView android:id="@+id/btn_go_mid" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:paddingLeft="10dp" android:paddingRight="12dp"
            android:text="查看TA" android:textColor="@color/white" android:textSize="14sp" android:visibility="gone" />
    </LinearLayout>
    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout android:id="@+id/swipe"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView android:id="@+id/recycler"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
