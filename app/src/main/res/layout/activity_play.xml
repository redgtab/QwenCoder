<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="48dp"
        android:background="@color/pink" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageButton android:id="@+id/btn_back" android:layout_width="40dp" android:layout_height="40dp"
            android:layout_marginLeft="4dp" android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@null" android:src="@android:drawable/ic_menu_revert" />
        <TextView android:id="@+id/tv_top_title" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginLeft="8dp" android:layout_weight="1" android:ellipsize="end"
            android:maxLines="1" android:textColor="@color/white" android:textSize="16sp" />
        <TextView android:id="@+id/btn_quality" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:paddingLeft="10dp" android:paddingRight="10dp"
            android:text="@string/quality" android:textColor="@color/white" android:textSize="14sp" />
        <TextView android:id="@+id/btn_danmaku_toggle" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center" android:paddingLeft="10dp" android:paddingRight="10dp"
            android:text="@string/danmaku_on" android:textColor="@color/white" android:textSize="14sp" />
    </LinearLayout>

    <FrameLayout android:id="@+id/player_box" android:layout_width="match_parent"
        android:layout_height="220dp" android:background="#000000" android:visibility="gone">
        <VideoView android:id="@+id/video_view" android:layout_width="match_parent" android:layout_height="match_parent" />
        <com.bililite.app.ui.DanmakuView android:id="@+id/danmaku_view" android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/tv_title" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="12dp" android:textColor="@color/text_primary" android:textSize="17sp" />
            <TextView android:id="@+id/tv_meta" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginLeft="12dp" android:layout_marginRight="12dp"
                android:textColor="@color/text_secondary" android:textSize="12sp" />
            <TextView android:id="@+id/tv_intro" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="12dp" android:background="@drawable/bg_card" android:padding="10dp"
                android:textColor="@color/text_primary" android:textSize="13sp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginLeft="12dp" android:layout_marginRight="12dp" android:orientation="horizontal">
                <Button android:id="@+id/btn_play" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginRight="6dp" android:background="@drawable/bg_pill"
                    android:padding="10dp" android:text="@string/play_builtin" android:textColor="@color/white" />
                <Button android:id="@+id/btn_play_ext" android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:layout_marginLeft="6dp" android:background="@drawable/bg_card"
                    android:padding="10dp" android:text="@string/play_external" android:textColor="@color/text_primary" />
            </LinearLayout>
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginLeft="12dp" android:layout_marginTop="8dp" android:layout_marginRight="12dp"
                android:text="@string/parts" android:textColor="@color/text_primary"
                android:textSize="15sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/part_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="12dp" android:orientation="vertical" />
            <TextView android:id="@+id/tv_comment_head" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginLeft="12dp" android:layout_marginRight="12dp"
                android:text="@string/comments" android:textColor="@color/text_primary"
                android:textSize="15sp" android:textStyle="bold" />
            <LinearLayout android:id="@+id/comment_list" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_margin="12dp" android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
