<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 专有 TV 版：必须支持遥控器（D-Pad），不要求触摸屏 -->
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />
    <uses-feature
        android:name="android.software.leanback"
        android:required="true" />
    <uses-feature
        android:name="android.hardware.gamepad"
        android:required="true" />

    <application
        android:name=".App"
        android:allowBackup="true"
        android:banner="@drawable/ic_banner"
        android:hardwareAccelerated="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:largeHeap="true"
        android:theme="@style/Theme.BiliLite.TV">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- Android TV 唯一启动入口（Leanback Launcher） -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.SearchActivity"
            android:exported="false" />

        <activity
            android:name=".ui.UserSpaceActivity"
            android:exported="false" />

        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />

        <activity
            android:name=".ui.PlayActivity"
            android:exported="false"
            android:configChanges="keyboardHidden|orientation|screenSize" />

        <activity
            android:name=".ui.DynamicActivity"
            android:exported="false" />

        <activity
            android:name=".ui.SettingsActivity"
            android:exported="false" />

        <activity
            android:name=".ui.FavFolderActivity"
            android:exported="false" />

        <activity
            android:name=".ui.RelationActivity"
            android:exported="false" />

        <activity
            android:name=".ui.CrashLogActivity"
            android:exported="false" />

        <activity
            android:name=".DetailsActivity"
            android:exported="true"
            android:launchMode="singleTop">
            <!-- TV 详情页入口：由 PlayActivity 在电视上跳转，接收视频数据参数 -->
            <intent-filter>
                <action android:name="com.bililite.app.VIDEO_DETAILS" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

    </application>

</manifest>
